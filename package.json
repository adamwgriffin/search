{
  "name": "search",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint --dir .",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "generate_listing_data": "bun run ./bin/generate_listing_data",
    "seed_listing_data": "bun run ./bin/seed_listing_data",
    "seed_boundary_data": "bun run ./bin/seed_boundary_data",
    "seed_dev_data": "bun run ./bin/seed_boundary_data && bun run ./bin/seed_listing_data",
    "generate_and_seed_listing_data": "bun run ./bin/generate_listing_data && bun run ./bin/seed_listing_data",
    "prisma:generate:local": "dotenv -e .env.local prisma generate",
    "prisma:validate:local": "dotenv -e .env.local prisma validate"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@turf/turf": "^7.3.5",
    "axios": "^1.18.1",
    "date-fns": "^4.4.0",
    "lodash": "^4.18.1",
    "mongoose": "^7.8.10",
    "next": "^16.2.9",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-content-loader": "^7.1.2",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-modal": "^3.16.3",
    "react-number-format": "^5.4.5",
    "react-redux": "^9.3.0",
    "react-use": "^17.6.1",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.65.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-modal": "^3.16.3",
    "@types/react-redux": "^7.1.34",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.6.0",
    "eslint-config-next": "16.2.9",
    "exponential-backoff": "^3.1.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.4",
    "prisma": "^5.22.0",
    "typescript": "^6.0.3",
    "yargs": "18.0.0"
  }
